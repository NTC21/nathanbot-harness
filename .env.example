# nathanbot env — KEY NAMES ONLY. Copy to .env (gitignored) and fill locally.
# Real secrets live in ~/.secrets/<service>/ — one folder per service (telegram,
# discord, google, hsnc, untabbed), NOT a single shared file. An earlier plan for
# a flat ~/.secrets/ai-hub.env was never built; per-service folders won because
# they keep the blast radius of any one key small and make rotation obvious.

# machine paths
CODE_ROOT=$HOME/Projects
SECRETS_DIR=~/.secrets

# google drive (media pipeline)
DRIVE_INBOX_FOLDER_ID=
DRIVE_OUTPUT_FOLDER_ID=

# add service keys as needed (referenced by .mcp.json via ${VAR})

# voice (scripts/speak.sh) — all optional, sensible defaults
NB_FISH_MODEL=          # Fish Audio model header (default s2.1-pro-free)
NB_FISH_VOICE=          # Fish Audio reference_id (default: British J.A.R.V.I.S)
NB_EDGE_VOICE=          # edge-tts voice (default en-GB-RyanNeural)

# claude wrapper (bin/claudew)
NB_CLAUDE_BIN=          # override the real claude binary claudew wraps
NB_CLAUDE_LIMIT_REGEX=  # override the usage-limit detector
NB_CHAT_MODEL=          # operator chat model alias (default: config/server.json)
NB_CHAT_EFFORT=         # low|medium|high|xhigh|max (default: config/server.json)
