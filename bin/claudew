#!/usr/bin/env bash
# claudew — the single choke point every headless `claude -p` call goes through.
#
# Runs the real claude CLI untouched and passes argv byte-identical, so
# --allowedTools, --permission-mode, --model, --effort and NB_OPERATOR all reach
# the CLI unchanged and the operator's safety fuses hold.
#
# It used to retry against a local Ollama model when usage capped. That was
# removed 2026-07-25: it had fired once in the system's lifetime, cost ~5GB plus a
# permanent daemon, and — the real problem — swapped the configured model for an
# 8B local one SILENTLY, on a system that stages email and calendar actions. A
# quietly worse answer about who to email is more dangerous than no answer.
#
# Now a cap fails loudly instead: the CLI's own error surfaces, plus one line
# saying what happened and what to do. Restore the old behaviour from git history
# (scripts/setup-fallback.sh + the pre-2026-07-25 version of this file).
#
#   NB_CLAUDE_BIN          override the real claude binary
#   NB_CLAUDE_LIMIT_REGEX  override the usage-limit detector
set -uo pipefail
R="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"   # launchd gives a bare PATH

# Headless means nobody is approving tool calls one by one — which is exactly the
# condition the guards' self-protection tier exists for. Mark it HERE rather than
# in each launchd plist: the tier only ever applies inside a claude session, and
# this file is the one thing that starts them. So a new scheduled job is covered
# by construction instead of by remembering a plist key — and this also covers
# com.nathanbot.server and skhd, whose plists have no generator in this repo, plus
# a manual `nb evolve` run from a terminal.
#
# Deliberately NOT NB_OPERATOR. That flag additionally means "this is the chat
# operator" and suppresses sending mail, calendar writes, git push and --apply
# (bin/nb, scripts/google/*, scripts/learn.sh). The scheduled jobs exist to apply
# things; setting NB_OPERATOR here would quietly turn them into no-ops.
export NB_UNATTENDED=1
# no call site pipes stdin; a non-tty pipe makes claude stall 3s waiting for it
[ -t 0 ] || exec </dev/null

REAL="${NB_CLAUDE_BIN:-}"
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then
  for c in "$(command -v claude 2>/dev/null || true)" \
           "$HOME/.local/bin/claude" /opt/homebrew/bin/claude \
           /usr/local/bin/claude "$HOME/.claude/local/claude"; do
    [ -n "$c" ] && [ -x "$c" ] && [ "$c" != "$0" ] && { REAL="$c"; break; }
  done
fi
[ -n "${REAL:-}" ] && [ -x "$REAL" ] || { echo "claudew: claude CLI not found" >&2; exit 127; }

# NB_CHECK=1 resolves and exits without running anything. Callers gate on this
# instead of `command -v claude`, which was the wrong question: launchd hands a
# bare PATH and runs `bash -lc`, which sources bash login files — and there are
# none on this machine, so ~/.local/bin (added by .zshrc) never appears. Every
# AI-backed scheduled job therefore died on its own gate one line BEFORE calling
# this file, which resolves the binary itself and would have found it.
# tasks/logs/digest.err is the receipt: "claude CLI not found".
[ -n "${NB_CHECK:-}" ] && { printf '%s\n' "$REAL"; exit 0; }

out="$(mktemp)"; err="$(mktemp)"
trap 'rm -f "$out" "$err"' EXIT
"$REAL" "$@" >"$out" 2>"$err"; rc=$?

LIMIT_RE="${NB_CLAUDE_LIMIT_REGEX:-usage limit reached|rate limit|overloaded|529|credit balance is too low}"

# Surface a cap explicitly. Callers still get the CLI's own output and exit code;
# this only adds a line so "capped" is never mistaken for "broken" — the failure
# mode that sent the owner looking at the model when a URL bug was at fault.
hit=""
if [ "$rc" -ne 0 ] && grep -qiE "$LIMIT_RE" "$out" "$err" 2>/dev/null; then hit=1; fi
grep -qiE '^claude ai usage limit reached\|[0-9]+' "$out" 2>/dev/null && hit=1

if [ -n "$hit" ]; then
  printf '{"ts":"%s","cmd":"claude-capped","dur_s":0,"rc":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" >> "$R/tasks/.telemetry.jsonl" 2>/dev/null || true
  echo "claudew: Claude usage is capped — this run did not complete. Retry after the reset." >&2
fi

cat "$out"; cat "$err" >&2; exit "$rc"
