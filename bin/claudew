#!/usr/bin/env bash
# claudew — the single choke point every headless `claude -p` call goes through.
#
# Runs the real claude CLI and passes argv through, so --allowedTools,
# --permission-mode, --model, --effort and NB_OPERATOR all reach the CLI
# unchanged and the operator's safety fuses hold.
#
# ONE addition, and it is deliberate: a minted --session-id, so the run's
# transcript can be located afterwards by id (see the trace block below). It is
# skipped when the caller supplies its own. stdout and stderr are still replayed
# byte-for-byte, so no caller's parsing changes — which is why the output format
# is left alone even though --output-format json would hand over the cost for
# free. Every caller reads plain text, including the [[SEND_DRAFT]] scan.
#
# It used to retry against a local Ollama model when usage capped. That was
# removed 2026-07-25: it had fired once in the system's lifetime, cost ~5GB plus a
# permanent daemon, and — the real problem — swapped the configured model for an
# 8B local one SILENTLY, on a system that stages email and calendar actions. A
# quietly worse answer about who to email is more dangerous than no answer.
#
# Now a cap fails loudly instead: the CLI's own error surfaces, plus one line
# saying what happened and what to do. Restore the old behaviour from git history
# (scripts/setup-fallback.sh + the pre-2026-07-25 version of this file).
#
#   NB_CLAUDE_BIN          override the real claude binary
#   NB_CLAUDE_LIMIT_REGEX  override the usage-limit detector
set -uo pipefail
R="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"   # launchd gives a bare PATH

# Headless means nobody is approving tool calls one by one — which is exactly the
# condition the guards' self-protection tier exists for. Mark it HERE rather than
# in each launchd plist: the tier only ever applies inside a claude session, and
# this file is the one thing that starts them. So a new scheduled job is covered
# by construction instead of by remembering a plist key — and this also covers
# com.nathanbot.server and skhd, whose plists have no generator in this repo, plus
# a manual `nb evolve` run from a terminal.
#
# Deliberately NOT NB_OPERATOR. That flag additionally means "this is the chat
# operator" and suppresses sending mail, calendar writes, git push and --apply
# (bin/nb, scripts/google/*, scripts/learn.sh). The scheduled jobs exist to apply
# things; setting NB_OPERATOR here would quietly turn them into no-ops.
export NB_UNATTENDED=1
# no call site pipes stdin; a non-tty pipe makes claude stall 3s waiting for it
[ -t 0 ] || exec </dev/null

REAL="${NB_CLAUDE_BIN:-}"
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then
  for c in "$(command -v claude 2>/dev/null || true)" \
           "$HOME/.local/bin/claude" /opt/homebrew/bin/claude \
           /usr/local/bin/claude "$HOME/.claude/local/claude"; do
    [ -n "$c" ] && [ -x "$c" ] && [ "$c" != "$0" ] && { REAL="$c"; break; }
  done
fi
[ -n "${REAL:-}" ] && [ -x "$REAL" ] || { echo "claudew: claude CLI not found" >&2; exit 127; }

# NB_CHECK=1 resolves and exits without running anything. Callers gate on this
# instead of `command -v claude`, which was the wrong question: launchd hands a
# bare PATH and runs `bash -lc`, which sources bash login files — and there are
# none on this machine, so ~/.local/bin (added by .zshrc) never appears. Every
# AI-backed scheduled job therefore died on its own gate one line BEFORE calling
# this file, which resolves the binary itself and would have found it.
# tasks/logs/digest.err is the receipt: "claude CLI not found".
[ -n "${NB_CHECK:-}" ] && { printf '%s\n' "$REAL"; exit 0; }

# Run FROM the repo. launchd gives a job whatever cwd it inherits — which is "/",
# and nothing in the chain (rundue.sh, bin/nb, the plists, jarvis.py) ever cd's.
# Measured before this line existed: 64 sessions under ~/.claude/projects/-/ with
# cwd "/", including 28 voice-operator runs. At "/" the CLI discovers no
# .claude/agents/, no CLAUDE.md, no AGENTS.md and no project settings — so the
# voice channel was handed a prompt naming six specialists that did not exist in
# its session, and every scheduled run was unattributable to a project.
#
# Safe because every prompt built in bin/nb interpolates absolute $R/... paths.
# NB_CWD overrides, for when a task should run against another repo and load that
# repo's CLAUDE.md instead of this one's.
cd "${NB_CWD:-$R}" 2>/dev/null || true

# ── trace ────────────────────────────────────────────────────────────────────
# Mint a session id and hand it to the CLI, so the run's transcript — which
# already holds tokens, model, and every tool call — can be found later by id.
# The trace line itself carries ONLY what the transcript cannot know: the job
# label and the process exit code. Everything else is read from the transcript
# by scripts/lib/transcripts.py.
#
# Invariants. Break these and the file silently corrupts:
#   * ONE printf, ONE line, short. bin/nb forks up to 8 concurrent claudew calls
#     (config/projects.json defaults.max_concurrent), and append atomicity here
#     is incidental — it holds because the lines are tiny.
#   * NEVER log argv or prompt text. Prompts are 15-25 KB of injected memory, and
#     nb evolve feeds this file back to a model.
#   * NOT tasks/.telemetry.jsonl. Three readers would degrade there; the worst is
#     learn.sh, which reads the whole file and counts .get("cmd") — trace records
#     would surface as phantom commands "the owner runs", so the system would learn
#     a false model of its owner from its own logs.
#   * NB_CHECK returns above this. Five callers use it purely to resolve the
#     binary; it must stay a hot no-op.
TRACE="$R/tasks/.traces.jsonl"
# self-rotate, same idiom as _telemetry in bin/nb — claudew can write when nb never runs
if [ -f "$TRACE" ] && [ "$(wc -c <"$TRACE" 2>/dev/null || echo 0)" -gt 5242880 ]; then
  mv -f "$TRACE" "$TRACE.old" 2>/dev/null || true
fi
# a caller that supplies its own id keeps it: passing the flag twice makes the
# CLI exit non-zero, and "every reply became couldn't-reach-the-brain" is a
# failure this repo has already shipped twice
case " $* " in
  *" --session-id "*) SID="" ;;
  *) SID="$(/usr/bin/uuidgen 2>/dev/null | tr 'A-Z' 'a-z')" ;;
esac
_trace() {  # $1=ev  $2=rc  $3=dur
  [ -n "${SID:-}" ] || return 0
  printf '{"ts":"%s","ev":"%s","session":"%s","job":"%s","cwd":"%s","rc":%s,"dur_s":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$SID" "${NB_JOB:-unknown}" "$PWD" \
    "${2:-null}" "${3:-null}" >> "$TRACE" 2>/dev/null || true
}
# START is written BEFORE the run and is not optional. subprocess.run(timeout=)
# in server.py and jarvis.py sends SIGKILL, which is uncatchable — so a
# post-run-only record loses exactly the 15-minute runs most worth seeing. Worse,
# the kill lands on this wrapper, not the grandchild claude, which survives and
# finishes writing its transcript: that run costs real money and would otherwise
# be invisible. A start with no end is reported as killed, with its true cost.
T0=$(date +%s)
_trace start

out="$(mktemp)"; err="$(mktemp)"
trap 'rm -f "$out" "$err"' EXIT
"$REAL" ${SID:+--session-id "$SID"} "$@" >"$out" 2>"$err"; rc=$?
_trace end "$rc" "$(( $(date +%s) - T0 ))"

LIMIT_RE="${NB_CLAUDE_LIMIT_REGEX:-usage limit reached|rate limit|overloaded|529|credit balance is too low}"

# Surface a cap explicitly. Callers still get the CLI's own output and exit code;
# this only adds a line so "capped" is never mistaken for "broken" — the failure
# mode that sent the owner looking at the model when a URL bug was at fault.
hit=""
if [ "$rc" -ne 0 ] && grep -qiE "$LIMIT_RE" "$out" "$err" 2>/dev/null; then hit=1; fi
grep -qiE '^claude ai usage limit reached\|[0-9]+' "$out" 2>/dev/null && hit=1

if [ -n "$hit" ]; then
  printf '{"ts":"%s","cmd":"claude-capped","dur_s":0,"rc":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" >> "$R/tasks/.telemetry.jsonl" 2>/dev/null || true
  echo "claudew: Claude usage is capped — this run did not complete. Retry after the reset." >&2
fi

# Expired auth, detected 2026-08-06. A cap is temporary and fixes itself; expired
# OAuth NEVER does, and it kills every scheduled AI pass at once -- evolve, learn,
# skills, dream, ideas, news, writeback all route through this file. On 2026-08-03
# the session expired and the passes went dark for three days while their launchd
# jobs kept exiting and nothing said why: `nb usage --failures` showed "crashed",
# which reads as a bug in ideas.sh rather than one login.
#
# Deliberately NOT folded into LIMIT_RE above: "retry after the reset" is the wrong
# instruction here and would send him waiting for a cap that is not the problem.
# Only the owner can fix this -- OAuth is interactive and no agent can complete it.
AUTH_RE="${NB_CLAUDE_AUTH_REGEX:-OAuth session expired|Failed to authenticate|Invalid API key|authentication_error|Please run .?claude login}"
if [ "$rc" -ne 0 ] && grep -qiE "$AUTH_RE" "$out" "$err" 2>/dev/null; then
  printf '{"ts":"%s","cmd":"claude-auth-expired","dur_s":0,"rc":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" >> "$R/tasks/.telemetry.jsonl" 2>/dev/null || true
  {
    echo "claudew: CLAUDE LOGIN HAS EXPIRED — this run did nothing, and neither will any"
    echo "         other scheduled pass (evolve, learn, skills, dream, ideas, news, writeback)."
    echo "         This does not heal on its own and no agent can fix it. Run: claude login"
  } >&2
fi

# A run that dies mid-response, detected 2026-08-10. This is the third failure
# shape and the only SILENT one: the CLI prints "API Error: Connection closed
# mid-response", exits 0, and the wrapper script treats the pass as a success.
# On 2026-08-10 both evolve and learn ended this way -- learn had written
# "Both persisted. Now trim OVERVIEW to bound." and then never trimmed it. The
# pass committed anyway. Half-applied self-modification that reports success is
# strictly worse than a pass that fails loudly, because the next pass starts
# from a state nobody knows is partial.
#
# Detected on OUTPUT, not rc, precisely because rc is 0 here -- a cap or an
# expired login at least exits non-zero.
#
# NOT retried on purpose. These passes commit, and dream/evolve/learn are not
# idempotent: re-running one that already wrote half its edits can apply them
# twice. Surfacing it so the next run (or the owner) sees a partial pass is the
# conservative half of the fix; making the passes resumable is a bigger change
# than a wrapper should make.
TRUNC_RE="${NB_CLAUDE_TRUNC_REGEX:-API Error: Connection closed mid-response|Connection closed mid-response}"
if grep -qiE "$TRUNC_RE" "$out" "$err" 2>/dev/null; then
  printf '{"ts":"%s","cmd":"claude-truncated","dur_s":0,"rc":%s,"rc_means":"truncated"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" >> "$R/tasks/.telemetry.jsonl" 2>/dev/null || true
  echo "claudew: run ended MID-RESPONSE — whatever it was doing is half-done. Check what it wrote before trusting it." >&2
fi

cat "$out"; cat "$err" >&2; exit "$rc"
