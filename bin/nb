#!/usr/bin/env bash
# nb — nathanbot CLI. One namespace for everything.
#
#   nb add "<idea>"        capture an idea (zero friction, never blocks)
#   nb inbox               show raw uncaptured inbox
#   nb triage              AI sorts inbox -> structured tasks
#   nb next                what to work on now
#   nb status              what's open / in flight / blocked
#   nb plan "<goal>"       decompose a big goal into tasks
#   nb done <id>           mark a task complete
#   nb decide [id]         resolve needs-decision items (approve/defer/drop)
#   nb groom [--apply]     archive stale tasks so the queue does not rot
#   nb discuss ["topic"]   talk freely; it interviews you and absorbs what it learns
#   nb today               open today's daily note in Obsidian (one shot)
#   nb digest              turn today's daily Obsidian notes -> tasks + saved facts
#   nb watch [--dry]       ambient awareness — imminent meetings, dirty repos, VIP mail
#
#   nb brief [--speak]     daily briefing — what's next, waiting, health; --speak reads it aloud
#   nb speak "<text>"      nathanbot says it out loud (Jarvis voice; NB_VOICE to change)
#   nb jarvis [once|text]  hands-free voice — say "Jarvis", ask, it acts + replies aloud
#   nb evolve [--apply]    improve the SYSTEM; --apply auto-fixes the safe tier (wiki/task hygiene)
#   nb learn               improve the model of YOU — analyze your decisions, propose memory
#   nb feedback "<note>"   tell it what to do differently — highest-priority learning signal
#   nb remember "<fact>"   keep durable knowledge/rules in nathanbot (EVERY harness sees it)
#   nb scout               research new tools/systems worth adopting
#   nb study <url|file>    ingest valuable knowledge into the wiki so it self-improves
#   nb wiki index|lint     rebuild wiki/index.md from frontmatter; lint pages vs SCHEMA
#   nb tidy [--apply]      machine maintenance: caches, dormant deps, uncommitted work
#
#   nb review              promote or drop AI-proposed tasks  (alias: suggestions)
#   nb ready <id>          greenlight a proposed task         (alias: ok)
#   nb plan-day [--commit] propose calendar time-blocks for the top ready tasks
#   nb cal <cmd>           calendar: agenda|today|list|search (writes are staged)
#   nb news                morning news brief
#   nb telegram            phone bridge — run the Telegram listener  (alias: tg)
#   nb activity            what shipped across your repos recently  (alias: ship)
#   nb project <cmd>       projects: new|add|list                    (alias: proj)
#   nb deliver "<text>"    push a message to your phone
#
#   nb usage [--days N]    what the agents actually did — cost, tools, dispatch, dead runs
#   nb writeback [--day]   turn a day's agent activity into a dated session note
#   nb recall "<query>"    search your run transcripts + commits (FTS over ~27k docs)
#
#   nb audit               self-heal check on the memory system
#   nb stale               find memory that no longer matches reality
#   nb new <name> [--type] scaffold a new project
#   nb server              start/check the headless API (http://127.0.0.1:7777)
#   nb sync                commit + push nathanbot
#   nb schedule install    make it ambient (launchd: brief daily, evolve+tidy weekly)
#   nb profile <cmd>       capability layers per project (list|show|apply|sync|check)
#   nb mail <cmd>          gmail: login|status|search|read|draft|send (--account required)
#   nb crm <cmd>           sheets CRM: append|touch|due|show  (e.g. nb crm due <pipeline>)
#   nb perms [set k lvl]   what Claude may do without asking (enforced in code)
#
set -uo pipefail

R="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# every AI call goes through claudew: identical to `claude`, but reports a usage
# cap explicitly and marks the run unattended (NB_UNATTENDED) for the guards.
# Gate on `NB_CHECK=1 "$CLAUDE"`, never `command -v claude` — see bin/claudew.
CLAUDE="$R/bin/claudew"

# ── task-writing standard — injected into every generator so no task is ever cryptic.
#    Full human doc: wiki/pages/task-style.md ────────────────────────────────────────────
TASK_STYLE='WRITE EVERY TASK SO NATHAN NEVER HAS TO ASK "what is this?" — assume a tired
non-engineer is reading it cold, months from now:
- title: a plain-English sentence, NOT a code/file reference. A decision starts with "Decide:".
  If it needs info from the owner before it can move, say that in the title.
- ask: (frontmatter, ONLY when something is genuinely owed by the owner) ONE plain-English
  sentence that IS the question, quoted. This is the line that reaches his phone and his
  morning brief, on its own, with no surrounding context — so it must stand alone and must
  not need decoding. Recommend an option inside it where you have one.
    GOOD  ask: "Where do you want to post personal writing, and how often? (LinkedIn, 2x/week?)"
    BAD   ask: "Platform and cadence. Options:"        <- not a question, needs the body
    BAD   ask: "Decide t-0028"                         <- a label, not a question
  Omit the field entirely if nothing is owed. Never write a placeholder.
- body, IN THIS EXACT ORDER, plain language, expand every acronym, no bare file paths up top:
    **What this is** — 1-2 sentences anyone understands.
    **Why it matters** — the concrete consequence of doing / not doing it.
    **What I need from you** — the exact decision or info, as clear options, recommend one.
       (include this section ONLY if something is genuinely owed by the owner; omit if just buildable)
    **Done when** — the observable finish line.
- ALL engineer detail goes LAST, under a short "*Technical:*" line. Never lead with it.'
INBOX="$R/tasks/inbox.md"
OPEN="$R/tasks/open"
DONE="$R/tasks/done"
mkdir -p "$OPEN" "$DONE"
[ -f "$INBOX" ] || printf '# Inbox\n\nDump raw ideas here, one per line. Run `nb triage` to file them.\n\n' > "$INBOX"

c_b=$'\033[1m'; c_d=$'\033[2m'; c_g=$'\033[32m'; c_y=$'\033[33m'; c_r=$'\033[31m'; c_0=$'\033[0m'

die() { printf "${c_r}%s${c_0}\n" "$1" >&2; exit 1; }

next_id() {
  local n=0 f
  # ARCHIVE too. Scanning only open/ + done/ meant an id was reused the moment
  # groom archived its original holder — 8 ids are currently duplicated, and
  # t-0027 points at two unrelated tasks, one of which a wiki page still cites.
  for f in "$OPEN"/*.md "$DONE"/*.md "$R/tasks/archive"/*.md; do
    [ -e "$f" ] || continue
    local i="${f##*/t-}"; i="${i%%-*}"; i="${i%.md}"
    # 10# forces base-10: zero-padded ids like 0008 are OCTAL in bash arithmetic otherwise
    [[ "$i" =~ ^[0-9]+$ ]] && [ $((10#$i)) -gt "$n" ] && n=$((10#$i))
  done
  printf "%04d" $((n+1))
}

# ── capture ──────────────────────────────────────────────────────────────────
cmd_add() {
  [ $# -gt 0 ] || die "usage: nb add \"your idea\""
  printf -- '- [ ] %s  <!-- %s -->\n' "$*" "$(date +%Y-%m-%d)" >> "$INBOX"
  printf "${c_g}captured${c_0}\n"
  # TASKS PAUSED: captures stay in the inbox; nothing auto-becomes a task.
  # Re-enable the task system by setting NB_TASKS_ON=1 (and restoring the operator
  # + digest/scout jobs). Opt out separately with NB_NO_AUTOTRIAGE=1.
  if [ -n "${NB_TASKS_ON:-}" ] && [ -z "${NB_NO_AUTOTRIAGE:-}" ] && NB_CHECK=1 "$CLAUDE" >/dev/null 2>&1; then
    ( _autotriage ) >/dev/null 2>&1 &
  fi
  return 0
}

# Background, lock-guarded, debounced triage. A burst of captures coalesces into
# one triage run; concurrent adds are safe because triage only clears what it saw.
_autotriage() {
  local lock="$R/tasks/.triage.lock"
  # steal a stale lock left by a crashed run (>5 min old) so triage never wedges
  if [ -d "$lock" ]; then
    local age; age=$(( $(date +%s) - $(stat -f %m "$lock" 2>/dev/null || echo 0) ))
    [ "$age" -gt 300 ] && rmdir "$lock" 2>/dev/null
  fi
  mkdir "$lock" 2>/dev/null || return 0    # mkdir is atomic — one triage at a time
  # literal path in the trap (the local is out of scope by the time EXIT fires)
  trap 'rmdir "'"$lock"'" 2>/dev/null' EXIT INT TERM
  sleep 4                                  # debounce: let a burst settle
  "$0" triage >/dev/null 2>&1 || true
  rmdir "$lock" 2>/dev/null
}

cmd_inbox() {
  local n; n=$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null; true)
  printf "${c_b}Inbox (%s untriaged)${c_0}\n" "$n"
  grep '^- \[ \]' "$INBOX" 2>/dev/null | sed 's/<!--.*-->//' | sed 's/^- \[ \]/  •/' || printf "  ${c_d}empty${c_0}\n"
}

# ── triage: AI files raw ideas into structured tasks ─────────────────────────
cmd_triage() {
  local n; n=$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null; true)
  [ "$n" -eq 0 ] && { printf "${c_d}inbox empty — nothing to triage${c_0}\n"; return 0; }
  NB_CHECK=1 "$CLAUDE" >/dev/null 2>&1 || die "claude CLI not found"

  # snapshot EXACTLY the items we're triaging — anything captured during triage survives
  local snap; snap=$(mktemp)
  grep '^- \[ \]' "$INBOX" > "$snap"

  printf "${c_b}Triaging %s item(s)...${c_0}\n" "$n"
  local prompt
  prompt=$(cat <<EOF
You are triaging the owner's idea inbox for nathanbot.

CONTEXT — read these first for conventions, projects, and hard rules:
- $R/shared-memory/OVERVIEW.md
- $R/config/projects.json  (valid project names + autonomy levels)

RAW INBOX ITEMS:
$(sed 's/<!--.*-->//' "$snap")

For EACH item, create one file at $OPEN/t-<NNNN>-<slug>.md starting at id $(next_id),
incrementing. Use this exact frontmatter:

---
id: t-NNNN
title: <clear actionable title>
domain: coding|content|research|language|ops
project: <a key from config/projects.json, or "none">
status: proposed|blocked|needs-decision
priority: 1..5   (1 = do first)
autonomy: inherit
created: $(date +%Y-%m-%d)
---

Then the body. $TASK_STYLE

RULES:
- If an item is vague, set status: needs-decision and write what you'd need to know.
- If it depends on something else, set status: blocked and say what blocks it.
- Never invent a project name that isn't in config/projects.json.
- Prefer small, independently executable tasks. Split anything that isn't.

Do NOT modify $INBOX — the CLI clears it after you finish.
Report a one-line summary per task created.
EOF
)
  local before; before=$(ls "$OPEN"/*.md 2>/dev/null | wc -l | tr -d ' ')
  NB_JOB=triage "$CLAUDE" -p "$prompt" --permission-mode acceptEdits 2>&1 | tail -30
  local after; after=$(ls "$OPEN"/*.md 2>/dev/null | wc -l | tr -d ' ')

  # State mutation happens HERE, in bash — and only if tasks were actually created.
  if [ "$after" -gt "$before" ]; then
    local arch="$R/tasks/.inbox-archive.md"
    { printf '\n## triaged %s\n' "$(date +%Y-%m-%d\ %H:%M)"; cat "$snap"; } >> "$arch" 2>/dev/null
    # remove EXACTLY the processed lines — keep the header + anything added during triage
    local tmp; tmp=$(mktemp)
    grep -vxF -f "$snap" "$INBOX" > "$tmp" && mv "$tmp" "$INBOX"
    printf "\n${c_g}triage complete${c_0} — %s task(s) created\n" "$((after-before))"
  else
    printf "\n${c_y}no tasks created — inbox left intact${c_0}\n"
  fi
  rm -f "$snap"
}

# ── read task frontmatter ────────────────────────────────────────────────────
_fm() { grep -m1 "^$2:" "$1" 2>/dev/null | sed "s/^$2:[[:space:]]*//"; }
# _fm returns the raw frontmatter value, so every caller re-stripped the quotes
# with the same sed. Factored once rather than adding a ninth copy.
_fmv() { _fm "$1" "$2" | sed 's/^"//;s/"$//'; }

# Route a task's domain to its memory workspace, so write-back fills the right
# folder instead of everything landing in 'general'. Keeps the 5-way split real.
_workspace_for() {
  case "$1" in
    coding)            echo "workspace-coding" ;;
    content|creative)  echo "workspace-creative" ;;
    research|language) echo "workspace-research" ;;
    ops|admin)         echo "workspace-admin" ;;
    *)                 echo "workspace" ;;
  esac
}

cmd_next() {
  # Decisions lead. nb next used to hide needs-decision items, so questions piled up
  # silently (t-0019). Now they surface first and can be resolved inline.
  local dlist=()
  for f in "$OPEN"/*.md; do
    [ -e "$f" ] || continue
    [ "$(_fm "$f" status)" = "needs-decision" ] && dlist+=("$f")
  done
  if [ ${#dlist[@]} -gt 0 ]; then
    printf "${c_y}%s answer(s) needed first${c_0}\n" "${#dlist[@]}"
    local now; now=$(date +%s)
    for f in "${dlist[@]}"; do
      local created age agestr; created=$(_fm "$f" created)
      age=$(( ( now - $(date -j -f "%Y-%m-%d" "$created" +%s 2>/dev/null || echo "$now") ) / 86400 ))
      agestr=""; [ "$age" -ge 7 ] && agestr=" ${c_r}(${age}d waiting)${c_0}"
      printf "  ${c_y}?${c_0} %-10s %-16s %s%b\n" "$(_fm "$f" id)" "[$(_fm "$f" project)]" "$(_fm "$f" title | sed 's/^"//;s/"$//')" "$agestr"
    done
    if [ -t 0 ] && [ -t 1 ]; then
      printf "  ${c_d}resolve now? [y] walk them · [Enter] skip to ready${c_0} > "
      read -r a </dev/tty
      [ "$a" = y ] && { printf "\n"; cmd_decide; }
    else
      printf "  ${c_d}→ 'nb decide' to resolve${c_0}\n"
    fi
    printf "\n"
  fi

  printf "${c_b}Next up${c_0}\n"
  local found=0
  for p in 1 2 3 4 5; do
    for f in "$OPEN"/*.md; do
      [ -e "$f" ] || continue
      [ "$(_fm "$f" priority)" = "$p" ] || continue
      [ "$(_fm "$f" status)" = "ready" ] || continue
      printf "  ${c_g}P%s${c_0} %-10s %-16s %s\n" "$p" "$(_fm "$f" id)" "[$(_fm "$f" project)]" "$(_fm "$f" title | sed 's/^"//;s/"$//')"
      found=$((found+1))
      [ "$found" -ge 8 ] && break 2
    done
  done
  [ "$found" -eq 0 ] && printf "  ${c_d}nothing ready — you decide what's ready ('nb review' to see suggestions)${c_0}\n"
  # proposed = AI suggestions waiting for your yes; kept OUT of ready so they don't distract
  local prop=0; for f in "$OPEN"/*.md; do [ -e "$f" ] && [ "$(_fm "$f" status)" = "proposed" ] && prop=$((prop+1)); done
  [ "$prop" -gt 0 ] && printf "  ${c_d}%s suggestion(s) waiting — 'nb review' to promote or drop${c_0}\n" "$prop"
  local ld=0; for f in "$OPEN"/*.md; do [ -e "$f" ] && [ "$(_fm "$f" status)" = "looks-done" ] && ld=$((ld+1)); done
  [ "$ld" -gt 0 ] && printf "  ${c_g}%s look(s) already finished — 'nb decide' to confirm${c_0}\n" "$ld"
  return 0
}

cmd_plan_day() {
  # Time-block today: take the top-N ready tasks and propose 90-min calendar
  # blocks against your free slots. --commit writes them (interactive confirm,
  # never for the operator). The daily-plan step of the Productivity OS.
  local commit=0; [ "${1:-}" = "--commit" ] && commit=1
  local args=() n=0 max="${NB_PLAN_N:-3}"
  for p in 1 2 3 4 5; do
    for f in "$OPEN"/*.md; do
      [ -e "$f" ] || continue
      [ "$(_fm "$f" priority)" = "$p" ] || continue
      [ "$(_fm "$f" status)" = "ready" ] || continue
      args+=(--task "$(_fm "$f" title | sed 's/^"//;s/"$//')")
      n=$((n+1)); [ "$n" -ge "$max" ] && break 2
    done
  done
  if [ "$n" -eq 0 ]; then
    printf "${c_d}nothing ready to block — 'nb triage' or 'nb add' first${c_0}\n"; return 0
  fi
  python3 "$R/scripts/google/gcalendar.py" planday "${args[@]}"
  if [ "$commit" -eq 1 ]; then
    [ -n "${NB_OPERATOR:-}" ] && die "nb plan-day --commit is disabled for the operator (calendar writes are the owner's call)"
    if [ -t 0 ] && [ -t 1 ]; then
      printf "\n${c_y}Write these blocks to your calendar? [y/N]${c_0} > "
      local a; read -r a </dev/tty
      [ "$a" = y ] || { printf "  skipped.\n"; return 0; }
      python3 "$R/scripts/google/gcalendar.py" planday "${args[@]}" --commit
    else
      printf "  ${c_d}(non-interactive — re-run 'nb plan-day --commit' in a terminal to write)${c_0}\n"
    fi
  else
    printf "${c_d}  → 'nb plan-day --commit' to put these on your calendar${c_0}\n"
  fi
  return 0
}

_set_status() {   # $1=file  $2=new status
  local tmp; tmp=$(mktemp)
  sed "s/^status:.*/status: $2/" "$1" > "$tmp" && mv "$tmp" "$1"
}

_find_open() {    # $1=id -> prints the open task file, or nothing
  local f; f=$(ls "$OPEN/$1-"*.md 2>/dev/null | head -1)
  [ -z "$f" ] && f=$(grep -rl "^id: $1\$" "$OPEN" 2>/dev/null | head -1)
  printf '%s' "$f"
}

cmd_promote() {   # nb ready <id> — YOU greenlight a suggestion into your ready list
  [ $# -gt 0 ] || die "usage: nb ready <task-id>   (promote a suggestion to your ready list)"
  local f; f=$(_find_open "$1"); [ -n "$f" ] || die "no open task $1"
  _set_status "$f" ready
  printf "${c_g}%s → ready${c_0}  %s\n" "$1" "$(_fm "$f" title | sed 's/^"//;s/"$//')"
}

cmd_review() {    # AI suggestions ('proposed') waiting on you — promote or drop, your call
  local list=()
  for f in "$OPEN"/*.md; do [ -e "$f" ] || continue
    [ "$(_fm "$f" status)" = "proposed" ] && list+=("$f"); done
  if [ ${#list[@]} -eq 0 ]; then
    printf "${c_d}no suggestions — your ready list is entirely yours${c_0}\n"; return 0; fi
  printf "${c_b}Suggestions${c_0} ${c_d}(not in your ready list until you say so)${c_0}\n"
  for f in "${list[@]}"; do
    printf "  ${c_y}?${c_0} %-10s %-14s %s\n" "$(_fm "$f" id)" "[$(_fm "$f" project)]" \
      "$(_fm "$f" title | sed 's/^"//;s/"$//')"
  done
  if [ -t 0 ] && [ -t 1 ]; then
    printf "\n${c_d}each: [y] make ready · [d] drop · [Enter] skip${c_0}\n"
    for f in "${list[@]}"; do
      printf "  %s > " "$(_fm "$f" title | sed 's/^"//;s/"$//' | cut -c1-46)"
      local a; read -r a </dev/tty
      # Both arms log. Neither used to: promoting and dropping through `nb review`
      # wrote nothing to .decisions.jsonl, so the whole review surface was
      # invisible to learn.sh -- and what the owner DROPS is the strongest available
      # signal about what he does not value.
      case "$a" in
        y) _log_decision "$f" approve; _set_status "$f" ready; printf "    ${c_g}→ ready${c_0}\n" ;;
        d) _log_decision "$f" drop; mkdir -p "$R/tasks/done"
           mv "$f" "$R/tasks/done/" 2>/dev/null; printf "    ${c_d}dropped${c_0}\n" ;;
      esac
    done
  else
    printf "\n${c_d}promote: nb ready <id>   ·   drop: nb done <id>${c_0}\n"
  fi
  return 0
}

cmd_status() {
  local ready=0 blocked=0 decide=0 running=0 done_n=0 proposed=0 failed=0 looksdone=0
  for f in "$OPEN"/*.md; do
    [ -e "$f" ] || continue
    case "$(_fm "$f" status)" in
      ready) ready=$((ready+1)) ;; blocked) blocked=$((blocked+1)) ;;
      needs-decision) decide=$((decide+1)) ;; running) running=$((running+1)) ;;
      proposed) proposed=$((proposed+1)) ;;
      # evolve found evidence this is already finished. It cannot close anything
      # itself -- this is the state where it hands the conclusion to the owner.
      looks-done) looksdone=$((looksdone+1)) ;;
      # cmd_run writes this on a failed task and the API accepts it, but no
      # reader displayed it — so a failed task was invisible in every surface
      failed) failed=$((failed+1)) ;;
    esac
  done
  for f in "$DONE"/*.md; do [ -e "$f" ] && done_n=$((done_n+1)); done
  printf "${c_b}Status${c_0}\n"
  printf "  ${c_g}ready${c_0}          %s  ${c_d}(what YOU greenlit)${c_0}\n" "$ready"
  printf "  ${c_d}proposed${c_0}       %s  ${c_d}(AI suggestions — 'nb review')${c_0}\n" "$proposed"
  printf "  ${c_y}running${c_0}        %s\n" "$running"
  printf "  ${c_y}blocked${c_0}        %s\n" "$blocked"
  printf "  ${c_r}needs decision${c_0} %s\n" "$decide"
  if [ "$failed" -gt 0 ]; then
    printf "  ${c_r}failed${c_0}         %s  ${c_d}(ran and did not finish)${c_0}\n" "$failed"
    for f in "$OPEN"/*.md; do
      [ -e "$f" ] || continue
      [ "$(_fm "$f" status)" = "failed" ] || continue
      printf "    ${c_r}%-10s${c_0} %s\n" "$(_fm "$f" id)" "$(_fm "$f" title | sed 's/^"//;s/"$//' | cut -c1-56)"
    done
  fi
  if [ "$looksdone" -gt 0 ]; then
    printf "  ${c_g}looks done${c_0}     %s  ${c_d}(evidence says finished — 'nb decide' to confirm)${c_0}\n" "$looksdone"
    for f in "$OPEN"/*.md; do
      [ -e "$f" ] || continue
      [ "$(_fm "$f" status)" = "looks-done" ] || continue
      printf "    ${c_g}%-10s${c_0} %s\n" "$(_fm "$f" id)" "$(_fmv "$f" title | cut -c1-56)"
    done
  fi
  printf "  ${c_d}done${c_0}           %s\n" "$done_n"
  printf "  ${c_d}inbox untriaged %s${c_0}\n" "$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null; true)"

  # proposed counts as waiting too. It means "written down, never looked at by
  # the owner" -- there are currently zero needs-decision items and four proposed
  # ones aged 4-5 days, so listing only needs-decision showed an empty section
  # while the queue had four unanswered questions in it.
  if [ $((decide + proposed)) -gt 0 ]; then
    printf "\n${c_r}Waiting on you:${c_0}\n"
    local now age flag; now=$(date +%s)
    for f in "$OPEN"/*.md; do
      [ -e "$f" ] || continue
      case "$(_fm "$f" status)" in needs-decision|proposed) ;; *) continue ;; esac
      age=$(( ( now - $(date -j -f "%Y-%m-%d" "$(_fm "$f" created)" +%s 2>/dev/null || echo "$now") ) / 86400 ))
      flag=""; [ "$age" -ge "${NB_CHASE_DAYS:-2}" ] && flag=" ${c_r}(${age}d)${c_0}"
      printf "  • %s %s%b\n" "$(_fm "$f" id)" "$(_fmv "$f" title)" "$flag"
    done
  fi
  return 0
}

# ── plan: decompose a goal ───────────────────────────────────────────────────
cmd_plan() {
  [ $# -gt 0 ] || die "usage: nb plan \"the big thing you want\""
  NB_CHECK=1 "$CLAUDE" >/dev/null 2>&1 || die "claude CLI not found"
  printf "${c_b}Planning:${c_0} %s\n" "$*"
  NB_JOB=plan "$CLAUDE" -p "Decompose this goal into independently executable tasks for the owner's nathanbot system.

GOAL: $*

Read $R/shared-memory/OVERVIEW.md and $R/config/projects.json first.

Create task files in $OPEN/ starting at id $(next_id), same frontmatter format as existing
files there (see any t-*.md). Rules:
- Each task must be independently runnable in ONE project (never cross projects).
- Order via priority (1 = first). Use status: blocked + note the dependency where real.
- Prefer 3-8 tasks. If the goal needs more, make the first task a deeper planning task.

$TASK_STYLE

Report the plan as a numbered list." --permission-mode acceptEdits 2>&1 | tail -30
}

# ── run: execute ready tasks, isolated per project ───────────────────────────
cmd_run() {
  # RETIRED 2026-07-27. Unattended task execution against real project code is a
  # capability that was built, never used, and has now been overtaken.
  #
  # The evidence, from the system's own records: no task has ever reached status
  # `ready`, so this function has never executed a single task. `nb next` answered
  # "nothing ready" ten times running. And on 2026-07-27 `nb evolve` proposed four
  # decisions; two were resolved in conversation the same day without the queue
  # being involved at all. Work happens in a session, not in a queue.
  #
  # It also got more dangerous while sitting unused: claudew now exports
  # NB_UNATTENDED, so a task executing here is fenced out of the very rails a
  # self-improvement task would need to touch — it would fail confusingly rather
  # than do anything useful.
  #
  # CAPTURE STAYS. `nb add` -> inbox -> `nb review` -> `nb decide` all still work;
  # that half earns its keep. Only autonomous execution is gone.
  #
  # To bring it back: git show 8e2243e:bin/nb had the full parallel runner
  # (per-project isolation, --auto/--only/--dry-run, background write-back).
  printf "${c_y}nb run is retired.${c_0}\n"
  printf "  It never ran a task — nothing ever reached status 'ready' — and work\n"
  printf "  happens in a session, not a queue.\n\n"
  printf "  Capture still works: ${c_b}nb add${c_0} -> ${c_b}nb review${c_0} -> ${c_b}nb decide${c_0}\n"
  printf "  To act on a task, open it and work it in a Claude Code session.\n"
  printf "  ${c_d}History: git show 8e2243e:bin/nb${c_0}\n"
  return 1
}

cmd_done() {
  [ $# -gt 0 ] || die "usage: nb done <id> [outcome note — what worked / what didn't]"
  local id="$1"; shift; local note="$*"
  local f; f=$(ls "$OPEN"/*"$id"*.md 2>/dev/null | head -1)
  [ -z "$f" ] && die "no open task matching '$id'"
  _log_decision "$f" complete "$note"
  sed -i '' 's/^status: .*/status: done/' "$f" 2>/dev/null
  mv "$f" "$DONE/"
  printf "${c_g}done${c_0} %s\n" "$(basename "$f")"
}

# ── feedback: explicit "do this differently" — the strongest learning signal ─
cmd_feedback() {
  local note="$*"
  [ -z "${note// }" ] && die "usage: nb feedback \"<what I should do differently>\""
  local jf="$R/tasks/.feedback.jsonl" src="${NB_FEEDBACK_SRC:-explicit}"
  python3 - "$note" "$jf" "$src" <<'PY'
import json, sys, datetime
note, jf, src = sys.argv[1], sys.argv[2], sys.argv[3]
with open(jf, "a") as fh:
    fh.write(json.dumps({
        "ts": datetime.datetime.now().isoformat(timespec="seconds"),
        "source": src, "note": note,
    }) + "\n")
PY
  printf "${c_g}feedback logged${c_0} — 'nb learn' folds it into how I work (highest-priority signal)\n"
}

# ── remember: file DURABLE knowledge into nathanbot's brain (every harness sees it) ─
cmd_remember() {
  NB_CHECK=1 "$CLAUDE" >/dev/null 2>&1 || die "claude CLI not found"
  local note="$*"
  [ -z "${note// }" ] && die "usage: nb remember \"<a fact or rule to keep>\""
  printf "${c_b}Filing to nathanbot's brain...${c_0}\n"
  NB_JOB=remember "$CLAUDE" -p "the owner wants to durably remember this in nathanbot so EVERY harness (Claude Code,
Codex, OpenClaw, the web/voice operator) sees it — never siloed in one harness's private memory:

\"$note\"

Route it to the RIGHT home (read $R/wiki/storage-policy.md + $R/AGENTS.md first):
- A coding/behavioral RULE or convention -> add a terse bullet to $R/wiki/pages/conventions.md.
- A durable FACT about his world/ventures -> the right $R/wiki/pages/*.md (create if needed;
  then update $R/wiki/index.md and $R/wiki/log.md).
- A preference for how to work with him -> conventions.md if cross-harness.
No duplication; keep it terse. Then print ONE line: what you saved and where." \
    --permission-mode acceptEdits \
    --allowedTools "Read" "Write" "Edit" "Grep" "Glob" 2>&1 | tail -8
  printf "${c_g}remembered${c_0} — rides the next push, or 'nb sync' now\n"
}

# ── decision journal: every choice the owner makes becomes signal ───────────────
_log_decision() {
  local f="$1" action="$2" note="${3:-}"
  # canonical action vocabulary (UI passes target status; CLI passes the verb)
  case "$action" in
    ready)   action=approve ;;
    blocked) action=defer ;;
    done)    action=resolve ;;
    # the server/UI path passes a target status; evolve flagging a finish is not
    # the owner deciding anything, so it gets its own verb rather than borrowing one
    looks-done) action=flag-done ;;
  esac
  # confirm-done / reopen come in from cmd_decide as verbs already. Kept distinct
  # from `resolve` on purpose: learn.sh tallies by_action, so "the system said
  # this was finished and the owner agreed" is a different and much more useful
  # signal than "the owner closed this himself".
  local jf="$R/tasks/.decisions.jsonl"
  python3 - "$f" "$action" "$jf" "$note" <<'PYEOF'
import json, sys, re, datetime, os
f, action, jf = sys.argv[1], sys.argv[2], sys.argv[3]
note = sys.argv[4] if len(sys.argv) > 4 else ""
try:
    t = open(f).read()
except Exception:
    sys.exit(0)
fm = {}
m = re.search(r"^---\n(.*?)\n---", t, re.S)
if m:
    for line in m.group(1).splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            fm[k.strip()] = v.strip()
rec = {
    "ts": datetime.datetime.now().isoformat(timespec="seconds"),
    "action": action,
    "id": fm.get("id"), "title": fm.get("title"),
    "project": fm.get("project"), "domain": fm.get("domain"),
    "priority": fm.get("priority"), "from_status": fm.get("status"),
    "created": fm.get("created"),
    "age_days": None,
    "note": note or None,
}
try:
    c = datetime.date.fromisoformat(fm.get("created", ""))
    rec["age_days"] = (datetime.date.today() - c).days
except Exception:
    pass
with open(jf, "a") as fh:
    fh.write(json.dumps(rec) + "\n")
PYEOF
}

# ── decide: the consumer for needs-decision. Closes the loop. ────────────────
cmd_decide() {
  local f
  if [ $# -gt 0 ]; then
    f=$(ls "$OPEN"/*"$1"*.md 2>/dev/null | head -1)
    [ -z "$f" ] && die "no open task matching '$1'"
  else
    # interactive: walk every item awaiting a call — questions AND the finishes
    # evolve flagged. Both are "the owner says yes or no"; they differ only in what
    # yes means, so they belong in one pass rather than a second command.
    local list=()
    for x in "$OPEN"/*.md; do
      [ -e "$x" ] || continue
      case "$(_fm "$x" status)" in needs-decision|looks-done) list+=("$x") ;; esac
    done
    [ ${#list[@]} -eq 0 ] && { printf "${c_d}nothing awaiting a decision${c_0}\n"; return 0; }
    printf "${c_b}%s decision(s) pending${c_0}\n\n" "${#list[@]}"
    for x in "${list[@]}"; do
      if [ "$(_fm "$x" status)" = "looks-done" ]; then
        printf "${c_g}%s${c_0} [%s] %s\n  ${c_d}evolve says this is already finished:${c_0}\n" \
          "$(_fm "$x" id)" "$(_fm "$x" project)" "$(_fmv "$x" title)"
        sed -n '/^\*\*Looks done/,$p' "$x" | sed '/^$/d;s/^/    /'
        printf "\n  ${c_g}[y]${c_0}es, it's done   ${c_y}[n]${c_0}o, back to ready   ${c_d}[s]${c_0}kip   [q]uit\n  > "
        read -r ans </dev/tty
        case "$ans" in
          y) _log_decision "$x" confirm-done
             sed -i '' 's/^status: .*/status: done/' "$x"; mv "$x" "$DONE/"
             printf "  ${c_g}→ done${c_0}\n\n" ;;
          n) _log_decision "$x" reopen
             sed -i '' 's/^status: .*/status: ready/' "$x"
             printf "  ${c_y}→ back to ready${c_0}\n\n" ;;
          q) break ;;
          *) printf "  ${c_d}skipped${c_0}\n\n" ;;
        esac
        continue
      fi
      printf "${c_b}%s${c_0} [%s] %s\n" "$(_fm "$x" id)" "$(_fm "$x" project)" "$(_fm "$x" title)"
      sed -n '/^---$/,/^---$/!p' "$x" | sed '/^$/d' | head -8 | sed 's/^/    /'
      printf "\n  ${c_g}[a]${c_0}pprove → ready   ${c_y}[d]${c_0}efer   ${c_r}[x]${c_0} drop   ${c_d}[s]${c_0}kip   [q]uit\n  > "
      read -r ans </dev/tty
      case "$ans" in
        a) _log_decision "$x" approve; sed -i '' 's/^status: .*/status: ready/' "$x"; printf "  ${c_g}→ ready${c_0}\n\n" ;;
        d) _log_decision "$x" defer;   sed -i '' 's/^status: .*/status: blocked/' "$x"; printf "  ${c_y}→ deferred${c_0}\n\n" ;;
        x) _log_decision "$x" drop;    mv "$x" "$DONE/"; printf "  ${c_r}→ dropped${c_0}\n\n" ;;
        q) break ;;
        *) printf "  ${c_d}skipped${c_0}\n\n" ;;
      esac
    done
    return 0
  fi
  printf "%s\n" "$(cat "$f")"
  printf "\n${c_g}[a]${c_0}pprove  ${c_y}[d]${c_0}efer  ${c_r}[x]${c_0} drop  > "
  read -r ans </dev/tty
  case "$ans" in
    a) _log_decision "$f" approve; sed -i '' 's/^status: .*/status: ready/' "$f"; printf "${c_g}→ ready${c_0}\n" ;;
    d) _log_decision "$f" defer;   sed -i '' 's/^status: .*/status: blocked/' "$f"; printf "${c_y}→ deferred${c_0}\n" ;;
    x) _log_decision "$f" drop;    mv "$f" "$DONE/"; printf "${c_r}→ dropped${c_0}\n" ;;
  esac
}

cmd_audit()  { "$R/scripts/audit.sh"; }
cmd_new()    { "$R/scripts/new-project.sh" "$@"; }
cmd_sync()   {
  # the chat/voice operator must not push to GitHub unattended
  [ -n "${NB_OPERATOR:-}" ] && die "nb sync is disabled for the operator — the owner runs it (or the nightly job does)"
  cd "$R" && git add -A && git commit -qm "${1:-chore: sync nathanbot}" 2>/dev/null
  # Report WHY, not just "not synced". These used to share one || branch, so an
  # expired credential, a dead network and a rejected non-fast-forward all
  # printed "no remote configured" — and the nightly job swallowed the exit code
  # on top of that, so cross-machine sync could fail silently for weeks.
  if ! git remote get-url origin >/dev/null 2>&1; then
    printf "${c_y}committed locally — no remote configured${c_0}\n"
    return 0
  fi
  local err; err=$(git push 2>&1) \
    && { printf "${c_g}synced${c_0}\n"; return 0; }
  printf "${c_r}committed locally but PUSH FAILED${c_0} — other machines are not seeing this\n"
  printf "${c_d}%s${c_0}\n" "$(printf '%s' "$err" | tail -3)"
  return 1
}

usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

# ── brief: the Jarvis moment. Runs daily, speaks first. ──────────────────────
cmd_brief() {
  local quiet=false speak=false deliver=false
  for a in "$@"; do case "$a" in --quiet) quiet=true ;; --speak) speak=true ;; --deliver) deliver=true ;; esac; done
  local out="$R/tasks/.brief-$(date +%Y-%m-%d).md"
  local ready=0 blocked=0 decide=0 proposed=0 looks_done=0
  for f in "$OPEN"/*.md; do
    [ -e "$f" ] || continue
    case "$(_fm "$f" status)" in
      ready) ready=$((ready+1));; blocked) blocked=$((blocked+1));; needs-decision) decide=$((decide+1));;
      proposed) proposed=$((proposed+1));; looks-done) looks_done=$((looks_done+1));;
    esac
  done

  # The questions the owner owes an answer to, in his words, resolved once and
  # reused by all three surfaces. t-0019 built a chaser in July and it never
  # produced a single reminder while four things waited -- it turned out to be
  # scoped to calendar events. This is the replacement, on the delivery path he
  # has actually confirmed he reads.
  local asks nask=0
  asks="$(python3 "$R/scripts/lib/asks.py" --tsv 2>/dev/null)"
  [ -n "$asks" ] && nask=$(printf '%s\n' "$asks" | grep -c . )

  if $speak || $deliver; then
    local h g s pl; h=$(date +%H); g="Hello"
    [ "$h" -lt 12 ] && g="Good morning"
    { [ "$h" -ge 12 ] && [ "$h" -lt 17 ]; } && g="Good afternoon"
    [ "$h" -ge 17 ] && g="Good evening"
    pl=""; [ "$decide" -ne 1 ] && pl="s"
    # today's shape across all calendars — line 1 is speakable, full block is for text.
    # Calendar-first: with the task queue paused, the day is the brief's real payload.
    local day dayline1
    day=$(python3 "$R/scripts/google/gcalendar.py" today 2>/dev/null)
    dayline1=$(printf '%s' "$day" | head -1)
    s="$g."
    # The question LEADS -- ahead of the calendar. "Something you actually read
    # tells you, in plain words, the question it is waiting on" is the whole
    # finish line of t-0036; putting it after the day's shape buries it.
    if [ "$nask" -gt 0 ]; then
      local q1 a1
      q1=$(printf '%s\n' "$asks" | head -1 | cut -f4)
      a1=$(printf '%s\n' "$asks" | head -1 | cut -f2)
      s="$s First: a question has been waiting $a1 days. $q1"
      [ "$nask" -gt 1 ] && s="$s And $((nask-1)) more behind it."
    fi
    [ -n "$dayline1" ] && s="$s $dayline1"
    if [ "$decide" -gt 0 ] && [ "$nask" -eq 0 ]; then s="$s $decide decision$pl waiting on you."
    elif [ "$ready" -gt 0 ]; then s="$s $ready ready to run."
    elif [ "$nask" -eq 0 ] && [ -z "$dayline1" ]; then s="$s All systems nominal. Nothing waiting."; fi
    # detached so the audio survives SwiftBar/launchd killing our process group
    if $speak; then
      if [ -n "${NB_BRIEF_DRYRUN:-}" ]; then printf 'SPEAK> %s\n' "$s"
      else . "$R/scripts/lib/detach.sh"; nb_detach "$R/scripts/speak.sh" "$s"; fi
    fi
    if $deliver; then
      local msg="" tg
      # Telegram is rate-limited on purpose: first ping when a question crosses
      # two days, then at most weekly. The brief itself lists everything overdue
      # every morning -- a phone that buzzes daily about the same four questions
      # gets muted, and then the chaser has silently stopped working again.
      tg="$(NB_BRIEF_DRYRUN="${NB_BRIEF_DRYRUN:-}" python3 "$R/scripts/lib/asks.py" --telegram 2>/dev/null)"
      if [ -n "$tg" ]; then
        msg="⏳ Waiting on your answer:"$'\n'"$tg"$'\n\n'"Reply here, or run: nb decide"$'\n\n'
      fi
      msg="$msg$g."
      [ -n "$day" ] && msg="$msg"$'\n'"$day"
      # Short form only. t-0027's full section alone is ~1000 chars; four of them
      # would blow Telegram's 4096-char body and deliver.sh fails silently
      # (curl -sf ... || true). The full text lives in the brief markdown file.
      if [ "$nask" -gt 0 ] && [ -z "$tg" ]; then
        msg="$msg"$'\n'"($nask question(s) still waiting — see the brief, or: nb decide)"
      fi
      if [ -n "${NB_BRIEF_DRYRUN:-}" ]; then printf 'DELIVER> %s\n' "$msg"
      else "$R/scripts/deliver.sh" "nathanbot — brief" "$msg" >/dev/null 2>&1 || true; fi
    fi
  fi

  { printf "# Brief — %s\n\n" "$(date '+%A %d %B %Y')"

    # FIRST section, above the queue counts. Prints nothing when nothing is
    # overdue, so the heading only ever appears when there is a real question.
    # Replaces the old "## Waiting on you" block, which listed needs-decision
    # only -- of which there are currently zero, so it rendered empty every day
    # while four questions sat unanswered.
    python3 "$R/scripts/lib/asks.py" --md 2>/dev/null

    printf "## Queue\n%s ready · %s proposed · %s blocked · %s awaiting your decision · %s untriaged\n\n" \
      "$ready" "$proposed" "$blocked" "$decide" "$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null; true)"

    # After the questions, before the queue: confirming a finish is a chore, not
    # the thing that should lead. The evidence comes with it so the confirmation
    # is a judgement rather than a trust exercise.
    if [ "$looks_done" -gt 0 ]; then
      printf "## Looks finished — confirm?\n"
      for f in "$OPEN"/*.md; do
        [ -e "$f" ] || continue
        [ "$(_fm "$f" status)" = "looks-done" ] || continue
        printf -- "- **%s** %s\n" "$(_fm "$f" id)" "$(_fmv "$f" title)"
        sed -n '/^\*\*Looks done/,$p' "$f" | sed '1d;/^$/d;s/^/  /'
      done
      printf "\n  → \`nb decide\` to confirm or send it back\n\n"
    fi

    printf "## Top of queue\n"
    local n=0
    for p in 1 2 3 4 5; do
      for f in "$OPEN"/*.md; do
        [ -e "$f" ] || continue
        [ "$(_fm "$f" priority)" = "$p" ] && [ "$(_fm "$f" status)" = "ready" ] && {
          printf -- "- P%s [%s] %s\n" "$p" "$(_fm "$f" project)" "$(_fm "$f" title)"; n=$((n+1)); }
        [ "$n" -ge 5 ] && break 2
      done
    done
    [ "$n" -eq 0 ] && printf -- "- (nothing ready)\n"

    printf "\n## Project activity (last 24h)\n"
    local any=0
    for d in "$HOME"/Projects/*/; do
      [ -d "$d/.git" ] || continue
      local since; since=$(cd "$d" && git log --oneline --since=24.hours 2>/dev/null | wc -l | tr -d ' ')
      [ "$since" -gt 0 ] && { printf -- "- %s: %s commit(s)\n" "$(basename "$d")" "$since"; any=1; }
    done
    [ "$any" -eq 0 ] && printf -- "- quiet\n"

    printf "\n## System health\n"
    local w; w=$("$R/scripts/audit.sh" 2>/dev/null | grep -c '⚠️' | head -1); w=${w:-0}
    [ "$w" -eq 0 ] && printf -- "- audit clean\n" || printf -- "- **%s audit warning(s)** — run \`nb audit\`\n" "$w"
    # Called out separately rather than folded into the audit count: stale memory
    # is the one warning type that makes nathanbot actively work against the owner,
    # and the pre-commit hook cannot see drift that originates outside this repo
    # (a file deleted elsewhere, a tool uninstalled). This is that second net.
    local st; st=$(python3 "$R/scripts/stale.py" --quiet 2>/dev/null | grep -cE '^\s{4}\S+:[0-9]+')
    [ "${st:-0}" -gt 0 ] && printf -- "- **%s stale memory reference(s)** — run \`nb stale\`; a session will act on these\n" "$st"
    # The guards protect credentials and the rails, and they are only ever run by
    # hand — the pre-push hook covers a push, this covers the days without one.
    # A suite that nobody runs cannot fail, which reads as evidence that it passed.
    local gt; gt=$(python3 "$R/claude-hooks/test_guards.py" 2>&1 | tail -1)
    case "$gt" in
      *"0 failing") : ;;
      *) printf -- "- **GUARD SUITE FAILING** (%s) — credentials/rails may be unprotected\n" "$gt" ;;
    esac
    local free; free=$(df -h / | tail -1 | awk '{print $4}')
    printf -- "- disk free: %s\n" "$free"
  } > "$out"

  $quiet || cat "$out"
  # COUNTS ONLY, never question text: this interpolates straight into an
  # AppleScript string literal, so a question containing a quote would break it
  # or worse. deliver.sh does this properly via system attribute; this one-liner
  # does not, so nothing free-form goes near it.
  command -v osascript >/dev/null 2>&1 && osascript -e "display notification \"$nask waiting on you · $ready ready\" with title \"nathanbot brief\"" 2>/dev/null
  printf "\n${c_d}saved: %s${c_0}\n" "${out/#$HOME/\~}"
  return 0
}

# selfapply's allowlist is a PATH filter -- it cannot see that an edit inside
# tasks/open/ changed `status:` to something this pass was never allowed to set.
# Evolve could already write `status: done` on any open task today; only the
# prompt stopped it. Now that the prompt actively authorises a status write, the
# prompt alone is not enough. looks-done is the only value it may set.
_evolve_status_guard() {
  local f bad=0 now
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in tasks/open/*) ;; *) continue ;; esac
    [ -f "$R/$f" ] || continue
    # Hands off anything that was ALREADY dirty when the pass began -- that is
    # the owner's uncommitted work, not this pass's. sa_commit has honoured this
    # from the start via SA_PRE; a guard that skipped the check would revert his
    # edits and, for an untracked file, delete it outright. Tested the hard way.
    _sa_was_dirty "$f" && continue
    now=$(grep -m1 '^status:' "$R/$f" | sed 's/^status:[[:space:]]*//')

    # (a) statuses evolve may never write, on a new file or an old one. Checked
    #     from the FILE, not the diff: a brand-new task file is untracked, and
    #     `git diff` says nothing at all about untracked paths -- so a diff-only
    #     guard waves every new file straight through.
    case "$now" in
      done|failed|running)
        printf '  reverting %s — evolve may not set status: %s\n' "$f" "$now" >&2
        git -C "$R" checkout -q -- "$f" 2>/dev/null || rm -f "$R/$f"
        bad=1; continue ;;
    esac

    # (b) on a TRACKED task, the only status it may change anything TO is
    #     looks-done. Creating a proposal with ready/needs-decision is fine;
    #     reaching into an existing task and relabelling it is not.
    if git -C "$R" ls-files --error-unmatch "$f" >/dev/null 2>&1 \
       && git -C "$R" diff -- "$f" | grep -q '^+status:' \
       && [ "$now" != "looks-done" ]; then
      printf '  reverting %s — evolve may only change an existing task to looks-done\n' "$f" >&2
      git -C "$R" checkout -q -- "$f" 2>/dev/null || rm -f "$R/$f"
      bad=1
    fi
  done < <(git -C "$R" status --porcelain -uall | sed 's/^...//')
  return $bad
}

# ── evolve: self-improvement. PROPOSES, never self-applies. ──────────────────
cmd_evolve() {
  NB_CHECK=1 "$CLAUDE" >/dev/null 2>&1 || die "claude CLI not found"
  local apply=false; [ "${1:-}" = "--apply" ] && apply=true
  # the operator may not trigger self-modification unattended
  [ -n "${NB_OPERATOR:-}" ] && apply=false
  local tel="$R/tasks/.telemetry.jsonl"

  # ── MUTUAL EXCLUSION — must wrap BOTH halves of this function ──────────────
  # Not just --apply. The propose half below writes new tasks/open/t-*.md, and
  # learn's allowlist is the two model-of-the owner pages, so learn would classify
  # those proposals as violations and rm -f them (untracked -> git checkout
  # fails -> the rm fallback in sa_commit). On 2026-07-27 t-0035..t-0039
  # survived only because learn happened to finish 4 minutes before they landed.
  # sa_release is also called by _nb_on_exit, so a crash cannot wedge the lock.
  . "$R/scripts/lib/selfapply.sh"
  sa_begin evolve || return $SA_EX_LOCKED

  # ── SAFE-TIER AUTO-APPLY (bounded · reversible · never pushed) ─────────────
  # Security: the system may edit ONLY its own knowledge (wiki) and tidy task
  # titles. Code, config, capabilities, AGENTS.md, secrets, and anything outside
  # this repo are OFF LIMITS. selfapply.sh compares against the PRE-pass dirty set,
  # so the owner's uncommitted work is never touched, committed, or reverted — a dirty
  # tree no longer disables the weekly self-improvement pass. Violations revert
  # file-by-file; staged content is secret-scanned; commits are local only.
  if $apply; then
    printf "${c_b}Applying safe-tier self-improvements...${c_0}\n"
    NB_JOB=evolve-apply "$CLAUDE" -p "You are nathanbot improving ITSELF. Apply ONLY safe-tier fixes, now.

YOU MAY EDIT ONLY THESE:
- $R/wiki/pages/*.md, $R/wiki/index.md, $R/wiki/log.md   (fix stale/wrong/orphaned knowledge)
- $R/tasks/open/*.md    (fix a typo'd title / obvious mislabel, AND flag finished work — below)

FLAGGING FINISHED WORK — the only status change you may ever make:
If you can cite SPECIFIC, CHECKABLE evidence that an open task's own \"Done when\" condition
is ALREADY satisfied — a commit hash, a file that now exists or is now gone, an audit line
that now passes — then for that task ONLY:
  1. set its frontmatter to exactly: status: looks-done
  2. append to the END of the body, in exactly this shape:

     **Looks done — $(date +%Y-%m-%d) (evolve)**
     - <one line of evidence, naming the commit / file / audit line>
     - <a second line if there is one>

  3. change nothing else in that file.

You may NOT move a file into $R/tasks/done/, delete anything, or set any other status value
on any task. the owner confirms with 'nb decide'. A wrong call costs him a glance; closing a
live task would cost him the task. If your evidence is inference rather than a citation, do
NOT flag it — mention it in your summary instead and let him judge.

ABSOLUTE BOUNDS — never, for any reason:
- Do NOT touch code ($R/bin, $R/scripts, $R/server), config ($R/config/*.json), capabilities,
  $R/AGENTS.md, anything under ~/.secrets, or ANY path outside $R.
- Do NOT change autonomy/permissions/identities or anything security-relevant.
- Do NOT delete files. Small, high-confidence, reversible edits only.

Evidence — audit:
$("$R/scripts/audit.sh" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | head -40)

Only change what you are confident is correct AND safe. If nothing qualifies, change nothing.
Print one line per edit." \
      --permission-mode acceptEdits \
      --allowedTools "Read" "Edit" "Write" "Grep" "Glob" 2>&1 | tail -20

    # GUARD — content check first (only looks-done may be written), then
    # selfapply keeps only allowlisted NEW changes, reverts violations per-file
    # (never the owner's pre-existing edits), secret-scans, commits locally.
    _evolve_status_guard || true
    sa_commit '^(wiki/|tasks/open/)' "auto-evolve: safe-tier self-improvement

Applied by 'nb evolve --apply' (wiki/task hygiene only). Not pushed.
Reversible: git revert HEAD"
    # These used to share one `||` branch, so a secret-scan revert and a failed
    # commit both printed "(nothing applied)" -- the same false-green this pass
    # exists to remove.
    case $? in
      1) printf "${c_d}(nothing applied)${c_0}\n" ;;
      2) printf "${c_r}evolve: pass REVERTED — secret-looking content in the edits${c_0}\n" >&2 ;;
      3) printf "${c_r}evolve: commit FAILED — edits are stranded in the working tree${c_0}\n" >&2 ;;
    esac
  fi

  printf "${c_b}Analyzing own usage and proposing deeper improvements...${c_0}\n"

  # Runs weekly from launchd, so it must not hold the default toolset. Write IS
  # needed — this pass creates proposal task files. Edit and Bash are not: the
  # prompt's own contract is "create tasks, modify nothing", and every piece of
  # evidence is baked in shell-side below.
  NB_JOB=evolve "$CLAUDE" -p "You are nathanbot analyzing ITSELF to propose improvements. Be concrete and evidence-based.

EVIDENCE — read all of these:
1. Usage telemetry (what the owner actually runs, how often, what fails):
$( [ -f "$tel" ] && tail -200 "$tel" || echo "(no telemetry yet)")

2. Audit output:
$("$R/scripts/audit.sh" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')

3. Current commands: $R/bin/nb
4. Memory system: $R/shared-memory/OVERVIEW.md, $R/AGENTS.md
5. Task queue state: $(ls "$OPEN"/*.md 2>/dev/null | wc -l | tr -d ' ') open tasks
6. Recent session notes: $R/workspace*/memory/ (read the latest few)

ANALYZE:
- Which nb commands does he actually use vs never touch? Unused commands are either
  badly designed or badly surfaced — say which.
- What sits blocked or needs-decision for a long time? That's friction to remove.
- What does he do MANUALLY that the system could absorb? (check recent session notes)
- Is memory going stale? Are wiki pages orphaned?
- What capability is obviously missing given how he works?

OUTPUT — create task files in $OPEN/ starting at id $(next_id), frontmatter matching
existing tasks there, with:
  project: nathanbot
  domain: ops
  status: two tiers —
    ready           <- ONLY for pure hygiene with zero judgment (fix a stale doc line,
                       repair a broken link, correct an obvious typo'd label). These
                       auto-approve so the queue doesn't silt up with trivia.
    needs-decision  <- EVERYTHING else: behavior changes, new capabilities, deletions,
                       anything security- or identity-adjacent. the owner approves.

$TASK_STYLE

Propose 2-5 improvements, highest leverage first. Each must cite the specific evidence
that motivated it. Do NOT modify any existing file — only create proposal tasks.
Then print a short summary of what you proposed and why." \
    --permission-mode acceptEdits \
    --allowedTools "Read" "Grep" "Glob" "Write" 2>&1 | tail -35

  printf "\n${c_g}proposals created${c_0} — review with 'nb status', they're all needs-decision\n"
  sa_release
}

# ── scout: find new tools/systems worth adopting ─────────────────────────────
cmd_scout() {
  NB_CHECK=1 "$CLAUDE" >/dev/null 2>&1 || die "claude CLI not found"
  printf "${c_b}Scouting new tools and systems...${c_0}\n"
  NB_JOB=scout "$CLAUDE" -p "Research tools, systems, or techniques the owner should know about.

HIS CONTEXT: read $R/shared-memory/OVERVIEW.md and $R/wiki/pages/owner.md.
Stack: Expo/React Native, Next.js, Cloudflare Workers, AWS SAM/Lambda, Python, ESP32.
He runs an AI-agnostic personal system (nathanbot) and cares about agent harnesses,
memory systems, automation, and developer productivity.

Use web search. Find things from the LAST 3 MONTHS specifically — not general advice.
Focus on: agent harnesses/frameworks, memory systems, dev tooling that would measurably
reduce his manual work.

For each genuinely worthwhile finding (max 3, quality over quantity):
- Create a wiki page at $R/wiki/pages/<slug>.md using the schema in $R/wiki/SCHEMA.md
  (type: reference, status: active), explaining what it is and specifically whether it
  would improve HIS setup — including honest reasons it might NOT be worth adopting.
- Add it to $R/wiki/index.md and log in $R/wiki/log.md.
- If it's genuinely worth acting on, ALSO create a task in $OPEN/ with
  project: nathanbot, status: needs-decision.
  $TASK_STYLE

If nothing meets the bar, say so plainly and create nothing. An empty scout is a valid result." --permission-mode acceptEdits 2>&1 | tail -30
}

# ── tidy: machine maintenance. Reports by default; --apply for safe actions. ─
cmd_tidy() {
  local apply=false; [ "${1:-}" = "--apply" ] && apply=true
  # the chat operator may report, but not delete unattended
  [ -n "${NB_OPERATOR:-}" ] && apply=false
  printf "${c_b}Machine tidy %s${c_0}\n" "$($apply && echo '(applying safe actions)' || echo '(report only — use --apply)')"

  printf "\n${c_b}Disk${c_0}\n  free: %s\n" "$(df -h / | tail -1 | awk '{print $4}')"

  printf "\n${c_b}node_modules in dormant repos (>45d since last commit)${c_0}\n"
  local total=0
  while IFS= read -r nm; do
    [ -z "$nm" ] && continue
    local repo="${nm%/node_modules}" days=9999
    local g="$repo"
    while [ "$g" != "/" ] && [ "$g" != "." ]; do [ -d "$g/.git" ] && break; g=$(dirname "$g"); done
    if [ -d "$g/.git" ]; then
      local last; last=$(cd "$g" && git log -1 --format=%ct 2>/dev/null)
      [ -n "$last" ] && days=$(( ($(date +%s) - last) / 86400 ))
    fi
    if [ "$days" -gt 45 ]; then
      local mb; mb=$(du -sm "$nm" 2>/dev/null | cut -f1)
      total=$((total + mb))
      printf "  %5s MB  %3sd  %s\n" "$mb" "$days" "${nm/#$HOME/\~}"
      $apply && rm -rf "$nm" && printf "         ${c_g}purged${c_0}\n"
    fi
  done < <(find "$HOME/Projects" -name node_modules -type d -prune 2>/dev/null)
  [ "$total" -eq 0 ] && printf "  ${c_d}none${c_0}\n" || printf "  ${c_b}total: %s MB${c_0}\n" "$total"

  printf "\n${c_b}Stray .DS_Store${c_0}\n"
  local ds; ds=$(find "$HOME/Projects" -name .DS_Store 2>/dev/null | wc -l | tr -d ' ')
  printf "  %s found\n" "$ds"
  $apply && [ "$ds" -gt 0 ] && find "$HOME/Projects" -name .DS_Store -delete 2>/dev/null && printf "  ${c_g}deleted${c_0}\n"

  printf "\n${c_b}Uncommitted work (risk of loss)${c_0}\n"
  local dirty=0
  for d in "$HOME"/Projects/*/; do
    [ -d "$d/.git" ] || continue
    local n; n=$(cd "$d" && git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && { printf "  %-28s %s file(s)\n" "$(basename "$d")" "$n"; dirty=$((dirty+1)); }
  done
  [ "$dirty" -eq 0 ] && printf "  ${c_d}all clean${c_0}\n"

  printf "\n${c_d}(tidy never deletes uncommitted work or anything without a remote)${c_0}\n"
  return 0
}

# ── telemetry: the system observes itself (local only, gitignored) ───────────
_telemetry() {
  local cmd="${1:-none}" started="$2" rc="$3"
  local dur=$(( $(date +%s) - started ))
  local out="${NB_TELEMETRY_FILE:-$R/tasks/.telemetry.jsonl}"
  # rotation: append-only logs must not grow forever. >5MB -> keep one .old generation.
  local jf
  for jf in "$R/tasks/.telemetry.jsonl" "$R/tasks/.decisions.jsonl" "$R/tasks/.feedback.jsonl"; do
    [ -f "$jf" ] && [ "$(stat -f %z "$jf" 2>/dev/null || echo 0)" -gt 5242880 ] \
      && mv "$jf" "$jf.old" 2>/dev/null
  done
  # rc has been written on every line since 2026-07-21 and read by NOTHING, so
  # `nb usage` could not answer the one question it was being run to answer.
  # rc_means records what a non-zero exit MEANT -- absent means a real failure.
  # "v":2 is the honesty marker: without it a reader cannot tell an old line's
  # rc=1 apart, and must say so rather than guess from a command-name list.
  local extra=""
  [ "$rc" -ne 0 ] && [ -n "${_RC_MEANS:-}" ] && extra=",\"rc_means\":\"$_RC_MEANS\""
  [ -n "${_SUB:-}" ] && extra="$extra,\"sub\":\"$_SUB\""
  printf '{"ts":"%s","v":2,"cmd":"%s","dur_s":%s,"rc":%s%s,"open":%s,"inbox":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$cmd" "$dur" "$rc" "$extra" \
    "$(ls "$OPEN"/*.md 2>/dev/null | wc -l | tr -d ' ')" \
    "$(grep -c '^- \[ \]' "$INBOX" 2>/dev/null; true)" \
    >> "$out" 2>/dev/null
}
_T0=$(date +%s); _CMD="${1:-help}"
_RC_MEANS=""      # set by the dispatch arms below where non-zero is not a failure

# `nb mail read` records cmd="mail", so a permission refusal and a genuine crash
# both land as `mail rc=1` and cannot be told apart. Record the sub-verb -- but
# ONLY for container commands, and ONLY a bare lowercase word. `nb add "call the
# accountant about the invoice"` must never write the owner's text into a log that
# evolve feeds to a model. tr -cd is a whitelist: nothing surviving it can break
# the JSON either.
_SUB=""
case "$_CMD" in
  mail|cal|crm|wiki|project|proj|profile|perms|permissions|schedule)
    case "${2:-}" in
      [a-z]*) [ "${#2}" -le 20 ] && _SUB="$(printf '%s' "$2" | tr -cd 'a-z0-9_-')" ;;
    esac ;;
esac

# ONE exit handler. selfapply.sh must never set its own EXIT trap on this path --
# it would replace this one and telemetry for `nb evolve` would stop without any
# symptom, which is the exact bug class the self-improvement fixes are about.
# `local rc=$?` MUST stay the first statement: anything before it clobbers $?.
_nb_on_exit() {
  local rc=$?
  type sa_release >/dev/null 2>&1 && sa_release   # no-op unless selfapply was sourced
  # 75 = a self-mod pass stood down because the other one held the lock. It did
  # nothing, but nothing is broken -- that is not a crash and must not read as one.
  [ "$rc" -eq 75 ] && _RC_MEANS=skipped
  _telemetry "$_CMD" "$_T0" "$rc"
}
trap _nb_on_exit EXIT
# route signals through EXIT so the lock is released on Ctrl-C / launchd SIGTERM
trap 'exit 130' INT
trap 'exit 143' TERM
# `nb next | head -5` closes the pipe under us. Without this the shell reports a
# plain 1, indistinguishable from a real failure, and the failure check fires on
# ordinary piping. 141 = 128 + SIGPIPE, which classifies as interrupted.
trap 'exit 141' PIPE

case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  inbox)  cmd_inbox ;;
  triage) cmd_triage ;;
  next)   cmd_next ;;
  review|suggestions) cmd_review ;;
  ready|ok|greenlight) shift; cmd_promote "$@" ;;
  status) cmd_status ;;
  plan)   shift; cmd_plan "$@" ;;
  plan-day|planday|day) shift; cmd_plan_day "$@" ;;
  run)    _RC_MEANS=retired; shift; cmd_run "$@" ;;
  done)   shift; cmd_done "$@" ;;
  decide) shift; cmd_decide "$@" ;;
  audit)  cmd_audit ;;
  usage)    shift; python3 "$R/scripts/usage.py" "$@" ;;
  writeback|wb) shift; "$R/scripts/writeback.sh" "$@" ;;
  recall)   shift; python3 "$R/scripts/recall.py" "$@" ;;
  # stale exits 3 when it FINDS drift — a result, not a crash. It still exits 1
  # on a real traceback, and that must stay legible as a failure, so only 3 is
  # relabelled. See the note at the bottom of scripts/stale.py.
  stale)  shift; python3 "$R/scripts/stale.py" "$@"
          _rc=$?; [ "$_rc" -eq 3 ] && _RC_MEANS=finding
          exit "$_rc" ;;
  brief)  shift; cmd_brief "$@" ;;
  evolve) shift; cmd_evolve "$@" ;;
  scout)  cmd_scout ;;
  tidy)   shift; cmd_tidy "$@" ;;
  new)    shift; cmd_new "$@" ;;
  sync)   shift; cmd_sync "$@" ;;
  schedule) shift
            [ -n "${NB_OPERATOR:-}" ] && die "nb schedule is disabled for the operator (persistence changes are the owner's call)"
            "$R/scripts/schedule.sh" "$@" ;;
  profile)  shift; "$R/scripts/profile.sh" "$@" ;;
  perms|permissions) shift; "$R/scripts/permissions.sh" "$@" ;;
  project|proj) shift; "$R/scripts/project.sh" "$@" ;;
  _logdecision) shift; _log_decision "$1" "$2" ;;
  discuss|talk) shift; "$R/scripts/discuss.sh" "$@" ;;
  learn)    shift; "$R/scripts/learn.sh" "$@" ;;
  feedback) shift; cmd_feedback "$@" ;;
  remember|memorize) shift; cmd_remember "$@" ;;
  watch)    shift; "$R/scripts/watch.sh" "$@" ;;
  jarvis)   shift; python3 "$R/scripts/voice/jarvis.py" "$@" ;;
  speak|say) shift; "$R/scripts/speak.sh" "$@" ;;
  deliver)   shift; "$R/scripts/deliver.sh" "$@" ;;
  telegram|tg) shift; python3 "$R/scripts/telegram/listen.py" "$@" ;;
  activity|ship|shipped) shift; python3 "$R/scripts/proactive/repo-activity.py" --report "$@" ;;
  news) shift; "$R/scripts/news.sh" "$@" ;;
  study)    shift; "$R/scripts/study.sh" "$@" ;;
  wiki)     shift; "$R/scripts/wiki.sh" "$@" ;;
  today)    open "obsidian://daily" 2>/dev/null || open -a Obsidian 2>/dev/null || die "Obsidian not found" ;;
  digest)   shift; "$R/scripts/digest.sh" "$@" ;;
  groom)    shift; "$R/scripts/groom.sh" "$@" ;;
  server|api|ui) shift
            # headless brain/API — no dashboard anymore; the phone (Telegram) talks to this.
            if curl -s -o /dev/null --max-time 1 http://127.0.0.1:7777/api/state 2>/dev/null; then
              echo "nathanbot API up: http://127.0.0.1:7777"
            else
              launchctl kickstart "gui/$(id -u)/com.nathanbot.server" 2>/dev/null \
                || (nohup python3 "$R/server/server.py" >/dev/null 2>&1 &)
              sleep 1; echo "started nathanbot API on :7777"
            fi ;;
  mail)     shift
            case "${1:-status}" in
              login|status|verify) python3 "$R/scripts/google/auth.py" "$@" ;;
              *) python3 "$R/scripts/google/gmail.py" "$@" ;;
            esac ;;
  cal)      shift; python3 "$R/scripts/google/gcalendar.py" "$@" ;;
  crm)      shift; python3 "$R/scripts/google/sheets.py" "$@" ;;
  ""|-h|--help|help) usage ;;
  # a typo, or a command that was removed — 10 of the 52 historical non-zero
  # lines landed here and were indistinguishable from a crash
  *) _RC_MEANS=unknown-verb; die "unknown command: $1  (try: nb help)" ;;
esac
